# Публичный адрес сайта (без слэша в конце).
# Нужен, чтобы canonical, sitemap и OG/Twitter-теги (в т.ч. og:image)
# были абсолютными и указывали на реальный домен — иначе WhatsApp
# не построит превью ссылки.
# Скопируйте в .env.local (или задайте в панели хостинга) и укажите свой домен.
NEXT_PUBLIC_SITE_URL=https://juliashik.netlify.app
